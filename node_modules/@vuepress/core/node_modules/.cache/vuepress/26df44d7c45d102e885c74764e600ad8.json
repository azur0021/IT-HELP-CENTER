)]),\n          _vm._v(\n            \"部分人员可能安装完成之后无法正常登录，请按照以下说明先简单排除一下问题：\"\n          ),\n          _c(\"br\"),\n          _vm._v(\n            \"\\n（1）没有加密软件的登录界面弹出，请查看桌面右下角区域，包括隐藏图标，找到一个灰色锁标示的图标，右键点击弹出菜单，点击【用户登录】即可看到用户登录界面，然后登录即可。\"\n          ),\n          _c(\"br\"),\n          _vm._v(\" \"),\n          _c(\"img\", {\n            attrs: { src: require(\"../esafenet/pic/7-5.png\"), alt: \"\" },\n          }),\n          _vm._v(\" \"),\n          _c(\"br\"),\n          _vm._v(\n            \"\\n（2）登录过程提示“用户名或密码错误”，该提示有两种情况：第一种是在安装软件过程中未正确输入服务器 IP 或者域名，请按照下图重新设置服务器地址。第二种是用户名和密码输入错误，请直接使用企业微信联系信息中心核对帐号密码信息。 \"\n          ),\n          _c(\"br\"),\n          _vm._v(\" \"),\n          _c(\"img\", {\n            attrs: { src: require(\"../esafenet/pic/7-6.png\"), alt: \"\" },\n          }),\n          _vm._v(\" \"),\n          _c(\"br\"),\n          _vm._v(\"\\n或者 \"),\n          _c(\"img\", {\n            attrs: { src: require(\"../esafenet/pic/7-7.png\"), alt: \"\" },\n          }),\n          _vm._v(\" \"),\n          _c(\"br\"),\n          _vm._v(\"\\n（3）如有任何问题可咨询信息中心协调处理，谢谢！\"),\n        ],\n        1\n      ),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"二、日常使用\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#二、日常使用\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 二、日常使用\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h4\", { attrs: { id: \"_1、如何解密\" } }, [\n        _c(\n          \"a\",\n          { staticClass: \"header-anchor\", attrs: { href: \"#_1、如何解密\" } },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 1、如何解密？\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [_vm._v(\"右击文件，众多选项中选择【申请解密】\")]),\n        _vm._v(\" \"),\n        _c(\"li\", [\n          _vm._v(\n            \"若无此项，请确定登录是否正常，网络连接是否正常，是否有安装各类游戏软件，360 等杀毒软件，各类性能检测工具等。\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [_vm._v(\"若各种情况都不存在，请联系信息中心调查处理。\"